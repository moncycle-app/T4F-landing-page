---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AssociationSection from '../../components/AssociationSection.astro';
import ProjectsSection from '../../components/ProjectsSection.astro';
import TeamSection from '../../components/TeamSection.astro';
import DonateSection from '../../components/DonateSection.astro';
import ContactSection from '../../components/ContactSection.astro';
import LatestNews from '../../components/LatestNews.astro';
import { langStaticPaths, sectionPath, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Sections in display order (numbered 01 → 05)
const sections = [AssociationSection, ProjectsSection, TeamSection, DonateSection, ContactSection];
---

<BaseLayout lang={lang} title={t('home.title')} description={t('home.description')} mainClass="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <p class="badge"><span class="badge-dot" aria-hidden="true"></span>{t('site.badge')}</p>
      <h1 id="hero-title">
        <span class="sr-only">{t('site.title')}</span>
        <span class="word" aria-hidden="true">Tech<span class="for"><span><span>for</span></span></span><span class="four"><span>4</span></span>Fertility</span>
      </h1>
      <p class="tagline">{t('site.tagline')}</p>
      <p class="hero-actions">
        <a class="btn btn-primary" href={sectionPath(lang, 'projects')}>{t('hero.ctaProjects')}</a>
        <a class="btn btn-ghost" href={sectionPath(lang, 'donate')}>{t('hero.ctaDonate')}</a>
      </p>
      <LatestNews lang={lang} />
    </div>
  </section>

  {sections.map((Section, i) => <Section lang={lang} index={i + 1} total={sections.length} />)}
</BaseLayout>
