---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, postSlug } from '../../../i18n/blog';
import { formatDate, langStaticPaths, localizedPath, useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';

export const getStaticPaths = langStaticPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<BaseLayout lang={lang} title={`${t('blog.title')} | Tech4Fertility`} description={t('blog.description')}>
  <h1 class="page-title">{t('blog.title')}</h1>
  <p class="lede">{t('blog.description')}</p>

  {posts.length === 0 ? (
    <p class="meta">{t('blog.empty')}</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a class="post-card" href={localizedPath(lang, `blog/${postSlug(post)}`)}>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
