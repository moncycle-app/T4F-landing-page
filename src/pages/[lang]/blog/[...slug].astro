---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, postLang, postSlug, type BlogPost } from '../../../i18n/blog';
import { formatDate, localizedPath, useTranslations } from '../../../i18n/utils';
import { langs, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const lang = postLang(post);
    // URL of each translation; falls back to the other language's post list
    const alternates = Object.fromEntries(
      langs.map((code) => {
        const tr = posts.find((p) => postLang(p) === code && p.data.translationKey === post.data.translationKey);
        return [code, tr ? localizedPath(code, `blog/${postSlug(tr)}`) : localizedPath(code, 'blog')];
      }),
    ) as Record<Lang, string>;
    return { params: { lang, slug: postSlug(post) }, props: { post, alternates } };
  });
}

interface Props {
  post: BlogPost;
  alternates: Record<Lang, string>;
}

const { post, alternates } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
---

<BaseLayout lang={lang} title={`${title} | Tech4Fertility`} description={description} alternates={alternates}>
  <article>
    <a class="back" href={localizedPath(lang, 'blog')}>{t('blog.back')}</a>
    <h1 class="page-title">{title}</h1>
    <p class="lede">{description}</p>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      {updatedDate && (
        <> · {t('blog.updated')} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time></>
      )}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
