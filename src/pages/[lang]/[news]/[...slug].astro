---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPosts, newsPath, newsSegment, postLang, postSlug, type NewsPost } from '../../../i18n/news';
import { formatDate, useTranslations } from '../../../i18n/utils';
import { langs, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const lang = postLang(post);
    // URL of each translation; falls back to the other language's news list
    const alternates = Object.fromEntries(
      langs.map((code) => {
        const tr = posts.find((p) => postLang(p) === code && p.data.translationKey === post.data.translationKey);
        return [code, newsPath(code, tr && postSlug(tr))];
      }),
    ) as Record<Lang, string>;
    return { params: { lang, news: newsSegment[lang], slug: postSlug(post) }, props: { post, alternates } };
  });
}

interface Props {
  post: NewsPost;
  alternates: Record<Lang, string>;
}

const { post, alternates } = Astro.props;
const lang = postLang(post);
const t = useTranslations(lang);
const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
---

<BaseLayout lang={lang} title={`${title} | Tech 4 Fertility`} description={description} alternates={alternates}>
  <article>
    <a class="back" href={newsPath(lang)}>{t('news.back')}</a>
    <h1 class="page-title">{title}</h1>
    <p class="lede">{description}</p>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
      {updatedDate && (
        <> · {t('news.updated')} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, lang)}</time></>
      )}
    </p>
    <div class="prose">
      <Content />
    </div>
    <dialog class="lightbox" aria-label={t('news.closeImage')}>
      <button type="button" class="lightbox-close" aria-label={t('news.closeImage')}>×</button>
      <img alt="" />
    </dialog>
  </article>
</BaseLayout>

<script>
  // Lightbox: click an image in the post to view it full size (Esc, click outside or × to close)
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const big = dialog?.querySelector('img');
  if (dialog && big) {
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      const open = () => {
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        dialog.showModal();
      };
      img.addEventListener('click', open);
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open();
        }
      });
    });
    // Any click closes it (the backdrop counts as a click on the dialog itself)
    dialog.addEventListener('click', () => dialog.close());
  }
</script>
