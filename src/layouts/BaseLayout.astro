---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import ContactButton from '../components/ContactButton.astro';
import PostalAddress from '../components/PostalAddress.astro';
import { langs, links, sectionKeys, type Lang, type UiKey } from '../i18n/ui';
import { localizedPath, sectionPath, useTranslations } from '../i18n/utils';
import { newsPath, newsRssPath, newsSegment } from '../i18n/news';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Page URL in each language. Default: same path with the language prefix swapped. */
  alternates?: Partial<Record<Lang, string>>;
  /** Class added to <main> */
  mainClass?: string;
  /** Asks search engines not to index the page */
  noindex?: boolean;
}

const { lang, title, description, alternates: custom = {}, mainClass, noindex } = Astro.props;
const t = useTranslations(lang);

const path = Astro.url.pathname;
const alternates = Object.fromEntries(
  langs.map((code) => [code, custom[code] ?? path.replace(new RegExp(`^/${lang}(?=/|$)`), `/${code}`)]),
) as Record<Lang, string>;
const canonical = new URL(path, Astro.site);
const section = path.split('/')[2] ?? '';

// Home page sections, linked from the header and the footer
const sectionLinks = sectionKeys.map((key) => ({
  key,
  href: sectionPath(lang, key),
  label: t(`nav.${key}` as UiKey),
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15130d" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {langs.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(alternates[code], Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/images/t4f-logo.png', Astro.site)} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    <link rel="icon" href="/images/favicon.ico" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/images/favicon-light.ico" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${t('news.title')} | ${t('site.title')}`} href={newsRssPath(lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Lets CSS collapse the mobile menu only when the script that opens it can run -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="home-link" href={localizedPath(lang)} aria-label={`${t('site.title')} – ${t('nav.home')}`}>
          <Logo />
        </a>
        <nav class="nav" id="site-nav" aria-label={t('nav.main')}>
          {sectionLinks.map((link) => (
            <a href={link.href} class:list={{ 'nav-donate': link.key === 'donate' }}>{link.label}</a>
          ))}
          <a href={newsPath(lang)} aria-current={section === newsSegment[lang] ? 'page' : undefined}>{t('nav.news')}</a>
        </nav>
        <LanguagePicker lang={lang} alternates={alternates} />
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">{t('nav.menu')}</span>
          <span class="menu-icon" aria-hidden="true"><span></span></span>
        </button>
      </div>
    </header>

    <main class={mainClass}>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <p class="foot-name"><Logo /> {t('site.title')}</p>
            <p>{t('site.tagline')}</p>
            <p class="foot-badge">{t('site.badge')}</p>
          </div>

          <nav class="foot-col" aria-labelledby="foot-nav-title">
            <h2 id="foot-nav-title">{t('footer.nav')}</h2>
            <ul>
              {sectionLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
              <li><a href={newsPath(lang)}>{t('nav.news')}</a></li>
              <li><a href={newsRssPath(lang)}>{t('news.rss')}</a></li>
            </ul>
          </nav>

          <div class="foot-col">
            <h2>{t('footer.projects')}</h2>
            <ul>
              <li><a href={links.moncycle} target="_blank" rel="noopener">moncycle.app<span class="sr-only"> {t('a11y.newTab')}</span></a></li>
            </ul>
            <h2>{t('footer.support')}</h2>
            <a class="foot-donate" href={links.helloAsso} target="_blank" rel="noopener">
              {t('nav.donate')}<span class="sr-only"> {t('a11y.newTab')}</span>
            </a>
          </div>

          <div class="foot-col">
            <h2>{t('footer.contact')}</h2>
            <ul>
              <li><ContactButton variant="link" /></li>
              <li><PostalAddress from={1} to={3} /></li>
            </ul>
          </div>
        </div>

        <p class="foot-legal">
          <span>© {new Date().getFullYear()} {t('site.title')}</span>
          <span>{t('footer.status')}</span>
          <span>RNA W271007328</span>
          <a href={localizedPath(lang, 'legal')} aria-current={section === 'legal' ? 'page' : undefined}>{t('footer.legalLink')}</a>
        </p>
      </div>
    </footer>

    <script>
      // Mobile menu: the toggle only shows below the desktop breakpoint (see .menu-toggle in global.css)
      const header = document.querySelector<HTMLElement>('.top');
      const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
      if (header && toggle) {
        const setOpen = (open: boolean) => {
          header.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', String(open));
        };
        toggle.addEventListener('click', () => setOpen(!header.classList.contains('open')));
        // Close after choosing a link, on Escape, and when switching to the desktop layout
        header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && header.classList.contains('open')) {
            setOpen(false);
            toggle.focus();
          }
        });
        matchMedia('(min-width: 960px)').addEventListener('change', () => setOpen(false));
      }
    </script>
  </body>
</html>
