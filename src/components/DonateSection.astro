---
import SectionHeading from './SectionHeading.astro';
import { links, sectionIds, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  index: number;
  total: number;
}
const { lang, index, total } = Astro.props;
const t = useTranslations(lang);

/** Income tax reduction for individuals (art. 200 CGI) */
const individualRate = 0.66;
const exampleAmount = 50;

const locale = lang === 'fr' ? 'fr-FR' : 'en-GB';
const percent = (value: number) => new Intl.NumberFormat(locale, { style: 'percent' }).format(value);
const euros = (value: number) =>
  new Intl.NumberFormat(locale, {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: Number.isInteger(value) ? 0 : 2,
    minimumFractionDigits: Number.isInteger(value) ? 0 : 2,
  }).format(value);
const exampleCost = Math.round(exampleAmount * (1 - individualRate) * 100) / 100;

const uses = [
  {
    title: t('donate.use1.title'),
    text: t('donate.use1.text'),
    // Shopping bag (app stores)
    icon: '<path d="M5 8h14l-1 12H6z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>',
  },
  {
    title: t('donate.use2.title'),
    text: t('donate.use2.text'),
    // Server rack
    icon: '<rect x="4" y="4" width="16" height="7" rx="2"/><rect x="4" y="13" width="16" height="7" rx="2"/><path d="M8 7.5h.01M8 16.5h.01"/>',
  },
  {
    title: t('donate.use3.title'),
    text: t('donate.use3.text'),
    // Globe
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.3 2.4 3.4 5.2 3.4 8.5s-1.1 6.1-3.4 8.5c-2.3-2.4-3.4-5.2-3.4-8.5S9.7 5.9 12 3.5z"/>',
  },
  {
    title: t('donate.use4.title'),
    text: t('donate.use4.text'),
    // Pulse line (monitoring)
    icon: '<path d="M3 12h4l2.5-6 5 12 2.5-6h4"/>',
  },
];
---

<section class="section section-donate" id={sectionIds[lang].donate} aria-labelledby="donate-title">
  <div class="wrap">
    <SectionHeading index={index} total={total} id="donate-title" title={t('donate.title')} />

    <p class="donate-message">
      {t('donate.message.1')} {t('donate.message.2')} <strong>{t('donate.message.3')}</strong>
    </p>

    <div class="donate-grid">
      <div>
        <h3 class="donate-subtitle">{t('donate.uses.title')}</h3>
        <ul class="uses">
          {uses.map((u) => (
            <li class="use">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={u.icon} />
              <h4>{u.title}</h4>
              <p>{u.text}</p>
            </li>
          ))}
        </ul>
      </div>

      <aside class="tax" aria-labelledby="tax-title">
        <h3 id="tax-title">{t('donate.tax.title')}</h3>
        <p class="tax-example">
          <span class="tax-figures" aria-hidden="true">
            <s>{euros(exampleAmount)}</s>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            <strong>{euros(exampleCost)}</strong>
          </span>
          <span class="tax-example-text">{t('donate.tax.example')}</span>
        </p>

        <dl class="tax-rules">
          <div>
            <dt>{t('donate.tax.individuals')} · {percent(individualRate)}</dt>
            <dd>{t('donate.tax.individuals.text')}</dd>
          </div>
          <div>
            <dt>{t('donate.tax.companies')} · {percent(0.6)}</dt>
            <dd>{t('donate.tax.companies.text')}</dd>
          </div>
        </dl>
        <p class="tax-receipt">{t('donate.tax.receipt')}</p>

        <!-- Calculator: shown only when JavaScript runs -->
        <form class="calc" data-calc data-rate={individualRate} hidden>
          <fieldset>
            <legend>{t('donate.calc.title')}</legend>
            <div class="calc-row">
              <label for="calc-amount">{t('donate.calc.amount')}</label>
              <input id="calc-amount" type="number" inputmode="decimal" min="1" step="1" value={exampleAmount} />
            </div>
            <div class="calc-row">
              <span id="calc-cost-label">{t('donate.calc.cost')}</span>
              <output for="calc-amount" aria-labelledby="calc-cost-label" aria-live="polite">{euros(exampleCost)}</output>
            </div>
            <p class="calc-note">{t('donate.calc.note')}</p>
          </fieldset>
        </form>

        <a class="btn btn-primary btn-large" href={links.helloAsso} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
          {t('donate.cta')}
          <span class="sr-only">{t('a11y.newTab')}</span>
        </a>
        <p class="secure">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/></svg>
          {t('donate.secure')}
        </p>
      </aside>
    </div>
  </div>
</section>

<script>
  // Real cost of a donation after the income tax reduction
  document.querySelectorAll<HTMLFormElement>('form[data-calc]').forEach((form) => {
    const input = form.querySelector('input');
    const output = form.querySelector('output');
    if (!input || !output) return;
    const rate = Number(form.dataset.rate);
    const locale = document.documentElement.lang === 'fr' ? 'fr-FR' : 'en-GB';

    const update = () => {
      const amount = Math.max(0, Number(input.value.replace(',', '.')) || 0);
      const cost = Math.round(amount * (1 - rate) * 100) / 100;
      const digits = Number.isInteger(cost) ? 0 : 2;
      output.value = new Intl.NumberFormat(locale, {
        style: 'currency',
        currency: 'EUR',
        minimumFractionDigits: digits,
        maximumFractionDigits: digits,
      }).format(cost);
    };

    form.addEventListener('submit', (event) => event.preventDefault());
    input.addEventListener('input', update);
    form.hidden = false;
    update();
  });
</script>
